<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Excel add-in manifest. Everything served by the local engine at https://127.0.0.1:5055 -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="TaskPaneApp">
  <Id>a64b585c-34c7-4447-b3ae-9aa8b3294bcf</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>ricepillow3000</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Anomaly Hunter"/>
  <Description DefaultValue="Flags abnormal rows in a sheet. Never deletes data."/>
  <IconUrl DefaultValue="https://127.0.0.1:5055/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://127.0.0.1:5055/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/ricepillow3000/excel-anomaly-hunter"/>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://127.0.0.1:5055/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="AnomalyGroup">
                <Label resid="Name"/>
                <Icon>
                  <bt:Image size="16" resid="Icon16"/>
                  <bt:Image size="32" resid="Icon32"/>
                  <bt:Image size="80" resid="Icon80"/>
                </Icon>
                <Control xsi:type="Button" id="OpenPane">
                  <Label resid="Name"/>
                  <Supertip>
                    <Title resid="Name"/>
                    <Description resid="Tip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>AnomalyPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://127.0.0.1:5055/assets/icon-16.png"/>
        <bt:Image id="Icon32" DefaultValue="https://127.0.0.1:5055/assets/icon-32.png"/>
        <bt:Image id="Icon80" DefaultValue="https://127.0.0.1:5055/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://127.0.0.1:5055/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Name" DefaultValue="Anomaly Hunter"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Tip" DefaultValue="Open the Anomaly Hunter panel."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
